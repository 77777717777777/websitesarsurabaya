# Salin file ini menjadi .env lalu isi sesuai environment lokal/produksi.
# JANGAN commit file .env yang sudah berisi kredensial asli.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sar_dashboard

# Ganti dengan string acak yang panjang di produksi (dipakai untuk session cookie signing)
SECRET_KEY=dev-secret-key-change-me

FLASK_DEBUG=1
FLASK_PORT=5000
